# Application Security & JWT (HMAC-SHA256 256-bit+ secret key)
JWT_SECRET=your_base64_or_hex_encoded_jwt_secret_key_at_least_256_bits_here

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80,http://frontend
