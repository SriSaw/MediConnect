# =========================================================================
# MediConnect - Root .gitignore
# Java 21 / Spring Boot 3.x / Maven + React / TypeScript / Vite
# =========================================================================

# --- Backend build artifacts ---
backend/target/
**/target/
*.class

# --- Frontend dependencies & build output ---
frontend/node_modules/
**/node_modules/
frontend/dist/
**/dist/
frontend/.vite/
frontend/dist-ssr/
*.local

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- IDEs & Editors ---
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
.factorypath
bin/

# --- Operating System & Temporary Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.swp
*.swo
*~
*.bak
*.tmp
*.log

# --- Package manager caches & crash logs ---
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Preserve wrapper, configs, locks, and source ---
!backend/mvnw
!backend/.mvn/wrapper/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.properties
!frontend/package-lock.json
